#!/bin/bash
#PBS -A DD_plasma_physics
#PBS -q debug-scaling
#PBS -l select=8:system=polaris
#PBS -l walltime=00:15:00
#PBS -l filesystems=home
#PBS -j oe
#PBS -N gb_p4_ssP
# Phase 4 strong scaling: same fixed global problem as Aurora (L=pi*192, NX=49152); 1..8 nodes x 32 ppn
cd ${PBS_O_WORKDIR}
module swap PrgEnv-nvidia PrgEnv-gnu >/dev/null 2>&1
module load cuda/13.0 craype-accel-nvidia80 >/dev/null 2>&1
module unload darshan xalt >/dev/null 2>&1
export OMP_NUM_THREADS=1
EXE=./ex2; PPNFLAG=--ppn
source run_common4.sh
LAUNCH="timeout 300 mpiexec"
OUT=runs_polaris_p4ss_${PBS_JOBID%%.*}; mkdir -p $OUT; st START; echo "start $(date -u)" > $OUT/summary.txt
hf() { head -n $1 $PBS_NODEFILE > $OUT/hosts_$1; echo "--hostfile $OUT/hosts_$1"; }
for N in 1 2 4 8; do BINDFLAGS="$(hf $N) --depth 1 --cpu-bind depth"; runx $((32*N)) 32 ss_np$((32*N)) $(Lof 192) 49152 0.05 100 1; done
echo "end $(date -u)" >> $OUT/summary.txt
python3 reduce3.py $OUT > $OUT/reduced.csv 2>&1
st "DONE rc_list=$(grep -o "rc=[0-9]*" $OUT/summary.txt | tr "\n" " ") out=~/grokbot-sp/p4/$OUT"
