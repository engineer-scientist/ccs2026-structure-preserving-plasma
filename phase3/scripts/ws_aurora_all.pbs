#!/bin/bash
#PBS -A DD_plasma_physics
#PBS -q debug-scaling
#PBS -l select=16
#PBS -l walltime=00:20:00
#PBS -l filesystems=home
#PBS -j oe
#PBS -N gb_p3_wsA
# Phase 3 step B (Aurora), whole sweep in one 16-node job (queue allows only 1 queued job/user).
# Sub-runs use the first N nodes via --hostfile. Order: fixed runs (1..16 nodes; patched ex2 -gb_wrap_hash_factor 2), then unfixed baselines.
cd ${PBS_O_WORKDIR}
export OMP_NUM_THREADS=1
EXE=./ex2_326; LAUNCH="timeout 300 mpiexec"; PPNFLAG=-ppn
OUT=runs_aurora_p3ws_${PBS_JOBID%%.*}; mkdir -p $OUT
source run_common.sh
echo "start $(date -u)" > $OUT/summary.txt
hf() { head -n $1 $PBS_NODEFILE > $OUT/hosts_$1; echo "--hostfile $OUT/hosts_$1"; }
for N in 1 2 4 8 16; do BINDFLAGS="$(hf $N) --cpu-bind depth -d 1"; [ $N -le 2 ] && DETAIL=1 || DETAIL=; run $((96*N)) 96 ws_fix_np$((96*N)) $(Lof $((96*N))) 0.05 100 1; done
DETAIL=
BINDFLAGS="$(hf 1) --cpu-bind depth -d 1"; run 1 1 ws_fix_np1 $(Lof 1) 0.05 100 1
for N in 1 2 4 8 16; do BINDFLAGS="$(hf $N) --cpu-bind depth -d 1"; run $((96*N)) 96 ws_base_np$((96*N)) $(Lof $((96*N))) 0.05 20 0; done
echo "end $(date -u)" >> $OUT/summary.txt
python3 reduce3.py $OUT > $OUT/reduced.csv 2>&1
