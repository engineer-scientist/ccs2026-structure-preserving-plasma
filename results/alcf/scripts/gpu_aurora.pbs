#!/bin/bash
#PBS -A DD_plasma_physics
#PBS -q debug
#PBS -l walltime=00:15:00
#PBS -l filesystems=home
#PBS -l select=1
#PBS -j oe
# Grok Bot: Aurora GPU trial of ex2 with module petsc/3.25.2-sycl (Kokkos/SYCL back end), single rank (module build fails at >1 rank)
cd ${PBS_O_WORKDIR}
module load petsc/3.25.2-sycl
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
OUT=runs_aurora_gpu_${PBS_JOBID%%.*}; mkdir -p $OUT
BASE="$(cat common_opts.txt) -em_ksp_type gmres -em_ksp_rtol 1e-8 -em_ksp_atol 1e-9 -ts_time_step 0.01 -ts_max_time 1.0 -ts_max_steps 100"
run() { TAG=$1; NX=$2; shift 2; T0=$(date +%s.%N)
  mpiexec -n 1 -ppn 1 --cpu-bind depth -d 8 "$@" -dm_plex_box_faces $NX -log_view :$OUT/logview_$TAG.txt > $OUT/ex2_$TAG.out 2>&1
  echo "$TAG nx=$NX rc=$? wall_s=$(echo "$(date +%s.%N) - $T0" | bc)" >> $OUT/summary.txt; }
run cpu_nx256 256 ./ex2 $BASE
run kokkos_nx256 256 /soft/tools/mpi_wrapper_utils/gpu_tile_compact.sh ./ex2 $BASE -dm_vec_type kokkos -dm_mat_type aijkokkos
run cpu_nx4096 4096 ./ex2 $BASE
run kokkos_nx4096 4096 /soft/tools/mpi_wrapper_utils/gpu_tile_compact.sh ./ex2 $BASE -dm_vec_type kokkos -dm_mat_type aijkokkos
