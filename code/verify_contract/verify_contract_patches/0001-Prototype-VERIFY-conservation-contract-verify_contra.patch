   return output
 
+@mcp.tool()
+def run_and_verify(executable: str, nsize: int = 1, args: str = '', timeout: float = 120, contract: str = '') -> dict:
+  """Run a compiled executable and check its VERIFY{} conservation line against a contract (JSON dict of
+     invariant-name -> tolerance; empty means the default structure-preserving contract).
+     Returns stdout, stderr, returncode and a 'verification' dictionary with keys pass, failures, records."""
+  import json, verify_contract
+  petscmcp.logToolCalled(executable)
+  res = run_executable(executable, nsize = nsize, args = args, timeout = timeout)
+  sc  = res.structured_content if hasattr(res, 'structured_content') else res
+  ver = verify_contract.check(sc.get('stdout', ''), json.loads(contract) if contract else None)
+  petscmcp.log('Verification result: ' + json.dumps(ver['pass']) + ' ' + json.dumps(ver['failures']) + '\n\n')
+  return ToolResult(structured_content={**sc, 'verification': ver})
+
 def main(transport: str = 'streamable-http', redirect_io : bool = True):
   global PETSC_DIR, PETSC_ARCH, WORK_DIR
   petscmcp.serverCheckKey('PETSC_DIR')
